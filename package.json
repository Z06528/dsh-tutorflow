{
  "name": "dsh-tutorflow",
  "version": "0.2.0",
  "description": "TutorFlow 通用教学增强：在 DeepSeek Harness 里给任何模型加一套会教书的方法——先判断要不要上课，再一步一步讲、一次只问一个问题、按回答调整，用本地图形辅助，并把学习进度与薄弱点记在本机。不限学科。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.browser.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.browser.js",
    "cordis.patch.yml",
    "lib",
    "skills",
    "locale",
    "market",
    "docs",
    "scripts",
    "icon.svg",
    "test",
    "README.md",
    "INSTALL.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sim": "node scripts/simulate.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "tutorflow",
    "teaching",
    "tutoring",
    "education",
    "pedagogy"
  ],
  "license": "MIT",
  "author": "Z06528",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Z06528/dsh-tutorflow.git"
  },
  "homepage": "https://github.com/Z06528/dsh-tutorflow#readme",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-skill": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
